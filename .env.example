# Optional Docker Compose overrides. Copy this file to .env in the repo root.
CLIENT_PORT=80
API_PORT=3001
DATABASE_PATH=/app/data/users.db
API_BASE_URL=http://server:3001
CLIENT_ORIGIN=http://localhost
# Set true only when serving the application over HTTPS.
COOKIE_SECURE=false
# debug | info | warn | error | silent
LOG_LEVEL=info
