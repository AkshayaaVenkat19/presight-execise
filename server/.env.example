# Server
# development | production | test
NODE_ENV=development
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
# DATABASE_PATH takes precedence; DB_PATH is accepted as a legacy alias.
DATABASE_PATH=./data/users.db
# DB_PATH=./data/users.db
# Set true when serving the application over HTTPS.
COOKIE_SECURE=false
# debug | info | warn | error | silent
LOG_LEVEL=info
